NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id>
NEO4J_PASSWORD=<password from Aura credentials download>
NEO4J_DATABASE=<instance-id>

# Voice layer (a LiveKit Cloud project just for this demo)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# OpenAI API key (Realtime)
OPENAI_API_KEY=
# Optional: where voice tools find the steuer-graph API
# STEUER_GRAPH_API=http://127.0.0.1:8000
